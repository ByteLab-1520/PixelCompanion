<Project>
  <PropertyGroup>
    <Version>0.5.3</Version>
    <AssemblyVersion>0.5.3.0</AssemblyVersion>
    <FileVersion>0.5.3.0</FileVersion>
    <InformationalVersion>0.5.3</InformationalVersion>
    <ProductEdition Condition="'$(ProductEdition)' == ''">Standard</ProductEdition>
    <DefineConstants Condition="'$(ProductEdition)' == 'Standard'">$(DefineConstants);PIXELCOMPANION_STANDARD</DefineConstants>
    <DefineConstants Condition="'$(ProductEdition)' == 'Yaroro'">$(DefineConstants);PIXELCOMPANION_YARORO</DefineConstants>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
