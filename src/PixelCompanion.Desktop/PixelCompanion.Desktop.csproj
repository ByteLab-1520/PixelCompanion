<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName Condition="'$(ProductEdition)' == 'Standard'">PixelCompanion</AssemblyName>
    <AssemblyName Condition="'$(ProductEdition)' == 'Yaroro'">PixelCompanion.Yaroro</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <ProjectReference Include="..\PixelCompanion.Core\PixelCompanion.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(ProductEdition)' == 'Standard'">
    <AvaloniaResource Include="..\..\assets\characters\DefaultCat\sprites\default-cat.png" Link="Assets\character-default.png" />
    <AvaloniaResource Include="..\..\assets\characters\DefaultCat\sprites\default-cat-back.png" Link="Assets\character-back.png" />
    <AvaloniaResource Include="..\..\assets\characters\DefaultCat\sprites\default-cat-walk-1.png" Link="Assets\character-walk-1.png" />
    <AvaloniaResource Include="..\..\assets\characters\DefaultCat\sprites\default-cat-walk-2.png" Link="Assets\character-walk-2.png" />
    <AvaloniaResource Include="..\..\assets\characters\DefaultCat\sprites\default-cat-walk-3.png" Link="Assets\character-walk-3.png" />
    <AvaloniaResource Include="..\..\assets\characters\DefaultCat\sprites\default-cat-eat-1.png" Link="Assets\character-eat-1.png" />
    <AvaloniaResource Include="..\..\assets\characters\DefaultCat\sprites\default-cat-eat-2.png" Link="Assets\character-eat-2.png" />
    <AvaloniaResource Include="..\..\assets\characters\DefaultCat\sprites\default-cat-sleep-1.png" Link="Assets\character-sleep-1.png" />
    <AvaloniaResource Include="..\..\assets\characters\DefaultCat\sprites\default-cat-sleep-2.png" Link="Assets\character-sleep-2.png" />
  </ItemGroup>
  <ItemGroup Condition="'$(ProductEdition)' == 'Yaroro'">
    <AvaloniaResource Include="..\..\assets\characters\Yaroro\sprites\yaroro-default.png" Link="Assets\character-default.png" />
    <AvaloniaResource Include="..\..\assets\characters\Yaroro\sprites\yaroro-back.png" Link="Assets\character-back.png" />
    <AvaloniaResource Include="..\..\assets\characters\Yaroro\sprites\yaroro-walk-1.png" Link="Assets\character-walk-1.png" />
    <AvaloniaResource Include="..\..\assets\characters\Yaroro\sprites\yaroro-walk-2.png" Link="Assets\character-walk-2.png" />
    <AvaloniaResource Include="..\..\assets\characters\Yaroro\sprites\yaroro-walk-3.png" Link="Assets\character-walk-3.png" />
    <AvaloniaResource Include="..\..\assets\characters\Yaroro\sprites\yaroro-eat-1.png" Link="Assets\character-eat-1.png" />
    <AvaloniaResource Include="..\..\assets\characters\Yaroro\sprites\yaroro-eat-2.png" Link="Assets\character-eat-2.png" />
    <AvaloniaResource Include="..\..\assets\characters\Yaroro\sprites\yaroro-sleep-1.png" Link="Assets\character-sleep-1.png" />
    <AvaloniaResource Include="..\..\assets\characters\Yaroro\sprites\yaroro-sleep-2.png" Link="Assets\character-sleep-2.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\assets\locales\*.json" Link="locales\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
