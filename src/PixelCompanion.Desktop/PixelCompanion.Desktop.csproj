<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PixelCompanion</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <ProjectReference Include="..\PixelCompanion.Core\PixelCompanion.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\characters\Yaroro\sprites\yaroro-default.png" Link="Assets\yaroro-default.png" />
    <AvaloniaResource Include="..\..\assets\characters\Yaroro\sprites\yaroro-back.png" Link="Assets\yaroro-back.png" />
    <AvaloniaResource Include="..\..\assets\characters\Yaroro\sprites\yaroro-walk-1.png" Link="Assets\yaroro-walk-1.png" />
    <AvaloniaResource Include="..\..\assets\characters\Yaroro\sprites\yaroro-walk-2.png" Link="Assets\yaroro-walk-2.png" />
    <AvaloniaResource Include="..\..\assets\characters\Yaroro\sprites\yaroro-walk-3.png" Link="Assets\yaroro-walk-3.png" />
    <AvaloniaResource Include="..\..\assets\characters\Yaroro\sprites\yaroro-eat-1.png" Link="Assets\yaroro-eat-1.png" />
    <AvaloniaResource Include="..\..\assets\characters\Yaroro\sprites\yaroro-eat-2.png" Link="Assets\yaroro-eat-2.png" />
    <AvaloniaResource Include="..\..\assets\characters\Yaroro\sprites\yaroro-sleep-1.png" Link="Assets\yaroro-sleep-1.png" />
    <AvaloniaResource Include="..\..\assets\characters\Yaroro\sprites\yaroro-sleep-2.png" Link="Assets\yaroro-sleep-2.png" />
    <Content Include="..\..\assets\locales\*.json" Link="locales\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
